GOOGLE_API_KEY=
EVIDENCE_MODEL=google_genai:gemini-3.1-flash-lite
REASONING_MODEL=gemini-3.1-flash-lite
REASONING_MAX_CONCURRENCY=2
REASONING_TIMEOUT_SECONDS=120
REASONING_MAX_CALLS_PER_INVESTIGATION=6
EVIDENCE_MAX_MODEL_CALLS_PER_ROUND=14
EVIDENCE_MAX_TOOL_CALLS_PER_ROUND=12
MAX_EVIDENCE_ITEMS_PER_INVESTIGATION=500
EVIDENCE_SOURCE_MAX_CONCURRENCY=3
CHECKPOINT_DATABASE_URL=postgresql://user:password@host:5432/tracex
CHECKPOINT_REQUIRED=true
MODEL_STRUCTURED_OUTPUT_MODE=auto
MAX_OUTPUT_REPAIRS=2
MODEL_RATE_LIMIT_RETRIES=2
CODEBASE_ROOT=
LOG_ROOT=
WEB_RESEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_ALLOWED_DOMAINS=docs.github.com,docs.python.org,www.mongodb.com,docs.langchain.com
