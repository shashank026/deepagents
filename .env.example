GOOGLE_API_KEY=
EVIDENCE_MODEL=google_genai:gemini-3.1-flash-lite
REASONING_MODEL=gemini-3.1-flash-lite
REASONING_MAX_CONCURRENCY=8
REASONING_TIMEOUT_SECONDS=120
REASONING_MAX_CALLS_PER_INVESTIGATION=6
EVIDENCE_MAX_MODEL_CALLS_PER_ROUND=14
EVIDENCE_MAX_TOOL_CALLS_PER_ROUND=12
MAX_EVIDENCE_ITEMS_PER_INVESTIGATION=500
EVIDENCE_SOURCE_MAX_CONCURRENCY=3
# Production: PostgreSQL URL. Local durable development may use
# sqlite+aiosqlite:///./tracex_checkpoints.sqlite.
CHECKPOINT_DATABASE_URL=
CHECKPOINT_REQUIRED=false
MODEL_STRUCTURED_OUTPUT_MODE=auto
MAX_OUTPUT_REPAIRS=2
MODEL_RATE_LIMIT_RETRIES=2
# Optional authorized local sources. GitHub sources normally arrive from backend_base.
CODEBASE_ROOT=
LOG_ROOT=

# Optional controlled public-web research. External sources are supporting
# context only; customer identifiers are rejected before any request.
WEB_RESEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_ALLOWED_DOMAINS=docs.github.com,docs.python.org,developer.mozilla.org,fastapi.tiangolo.com,docs.pydantic.dev,docs.sqlalchemy.org,www.mongodb.com,dev.mysql.com,www.postgresql.org,docs.oracle.com,docs.langchain.com,developers.facebook.com,developers.google.com,cloud.google.com,docs.aws.amazon.com,learn.microsoft.com
